{
  "name": "dorka",
  "description": "A local multi-engine search-operator workspace for Windows.",
  "version": "1.0.0",
  "author": "noxian0",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "desktop",
    "electron",
    "search-operators",
    "research-workspace",
    "security-research"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "package:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dorka.searchworkspace",
    "productName": "dorkA",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "dorkA.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "dorkA.ico"
    }
  }
}
